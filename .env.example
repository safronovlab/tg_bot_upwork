# Минимально-достаточный набор. Остальные настройки (модели, промты, пороги, пресеты)
# редактируются через сам бот после первого старта (см. ARCHITECTURE.md §4.2).
#
# ВНИМАНИЕ: реальные значения НИКОГДА не коммитятся. На сервере секреты задаются
# в Coolify UI → Environment Variables. Локально — копировать в .env (gitignored).

# --- секреты доступа ---
# Bot: @upwork_lead_filter_bot. На сервере должен быть единственный консьюмер
# getUpdates — локальный экземпляр обязательно остановить перед стартом сервера
# (иначе Telegram отдаст 409 Conflict). См. DEPLOY.md §3.
TELEGRAM_BOT_TOKEN=<telegram-bot-token-from-botfather>
ALLOWED_USER_IDS=<your-telegram-user-id>           # comma-separated, single-user

# --- БД (Coolify-managed Postgres 18, docker network: coolify) ---
# DSN внутри сети coolify: hostname = container-id Postgres-ресурса.
DATABASE_URL=postgresql://postgres:<db-password>@l6bjbfahvgll4rvvtqzxv24g:5432/postgres

# --- bootstrap для secrets.openrouter_api_key (приоритет: secrets таблица → env) ---
OPENROUTER_API_KEY=<openrouter-api-key>

# --- webhook auth ---
# Скрейпер должен слать заголовок: Authorization: Bearer <WEBHOOK_BEARER_TOKEN>
# Сгенерировать новый: openssl rand -hex 32
# Пустая строка отключает проверку (только dev/тесты!).
WEBHOOK_BEARER_TOKEN=<openssl-rand-hex-32>

# --- runtime тюнинг ---
LLM_CONCURRENCY=5
PIPELINE_BACKGROUND_TIMEOUT=120
LOG_LEVEL=INFO

# Минимальный рейтинг для попадания в очередь Отчёта при is_paused=True.
# Днём бот живой → analysis_threshold (настраивается в TG-боте, по умолч. 5).
# Ночью при остановке копятся только вакансии >= PAUSED_MIN_RATING. См. config.py.
PAUSED_MIN_RATING=7

# Лимит одновременных pipeline-задач внутри одного batch'а (защита от 10k items в payload).
BATCH_FANOUT_LIMIT=50

# Circuit breaker для OpenRouter: trip после THRESHOLD подряд-failure'ов в окне WINDOW_S
# секунд → fail-fast на TRIP_S секунд. 0 = выключен.
LLM_CIRCUIT_THRESHOLD=10
LLM_CIRCUIT_WINDOW_S=60
LLM_CIRCUIT_TRIP_S=30

# --- опциональные OpenRouter заголовки (LLM.md §1) ---
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=Upwork AI Pipeline
